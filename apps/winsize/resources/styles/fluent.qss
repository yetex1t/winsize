/* Fluent-inspired light theme for WinSize. */

/* Global defaults. */
QWidget {
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 10.5pt;
    color: #1A1A1A;
    background-color: #F3F3F3;
}

/* Main window. */
QMainWindow {
    background-color: #F3F3F3;
}

QMainWindow::separator {
    width: 1px;
    background-color: #E5E5E5;
}

/* Menu bar. */
QMenuBar {
    background-color: transparent;
    border-bottom: 1px solid #E5E5E5;
    padding: 2px 8px;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: rgba(0, 0, 0, 0.04);
}

QMenuBar::item:pressed {
    background-color: rgba(0, 0, 0, 0.06);
}

/* Drop-down menus. */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 28px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: rgba(0, 0, 0, 0.04);
}

QMenu::separator {
    height: 1px;
    background-color: #E5E5E5;
    margin: 4px 8px;
}

/* Status bar. */
QStatusBar {
    background-color: transparent;
    border-top: 1px solid #E5E5E5;
    color: #616161;
    font-size: 9.5pt;
    padding: 2px 8px;
}

/* Push buttons. */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-bottom: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 5px 20px;
    min-height: 22px;
    color: #1A1A1A;
    outline: none;
}

QPushButton:hover {
    background-color: #F9F9F9;
    border: 1px solid #E0E0E0;
    border-bottom: 1px solid #C4C4C4;
}

QPushButton:pressed {
    background-color: #F0F0F0;
    border: 1px solid #D6D6D6;
    border-bottom: 1px solid #D6D6D6;
    color: #616161;
}

QPushButton:disabled {
    background-color: #F5F5F5;
    border: 1px solid #E8E8E8;
    color: #BFBFBF;
}

/* Accent style for btnResizeAndCenter. */
QPushButton#btnResizeAndCenter {
    background-color: #0078D4;
    border: 1px solid #0067B8;
    border-bottom: 1px solid #005A9E;
    color: #FFFFFF;
}

QPushButton#btnResizeAndCenter:hover {
    background-color: #1A86D9;
    border: 1px solid #0078D4;
    border-bottom: 1px solid #0067B8;
}

QPushButton#btnResizeAndCenter:pressed {
    background-color: #006CBE;
    border: 1px solid #005A9E;
    color: rgba(255, 255, 255, 0.7);
}

QPushButton#btnResizeAndCenter:disabled {
    background-color: #F5F5F5;
    border: 1px solid #E8E8E8;
    color: #BFBFBF;
}

/* Spin boxes. */
QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-bottom: 2px solid #999999;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 22px;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QSpinBox:hover {
    border-bottom: 2px solid #7A7A7A;
}

QSpinBox:focus {
    border-bottom: 2px solid #0078D4;
    background-color: #FFFFFF;
}

QSpinBox:disabled {
    background-color: #F5F5F5;
    border: 1px solid #E8E8E8;
    border-bottom: 1px solid #E8E8E8;
    color: #BFBFBF;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 24px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: rgba(0, 0, 0, 0.04);
    border-radius: 3px;
}

QSpinBox::up-arrow {
    image: url(:/icons/spin_up.png);
    width: 14px;
    height: 9px;
}

QSpinBox::down-arrow {
    image: url(:/icons/spin_down.png);
    width: 14px;
    height: 9px;
}

/* Labels. */
QLabel {
    background-color: transparent;
    color: #1A1A1A;
    padding: 0px 4px;
}

/* Table widget. */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F9F9F9;
    border: 1px solid #E5E5E5;
    border-radius: 8px;
    gridline-color: #F0F0F0;
    selection-background-color: #E8F0FE;
    selection-color: #1A1A1A;
    outline: none;
    padding: 2px;
}

QTableWidget::item {
    padding: 6px 24px;
    border: none;
    border-bottom: 1px solid #F0F0F0;
}

QTableWidget::item:selected {
    background-color: #D6E7FF;
    color: #1A1A1A;
}

/* Table header. */
QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #FFFFFF;
    color: #616161;
    font-size: 9.5pt;
    font-weight: 600;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #E5E5E5;
    border-right: 1px solid #F0F0F0;
}

QHeaderView::section:last {
    border-right: none;
}

QHeaderView::section:hover {
    background-color: #F9F9F9;
    color: #1A1A1A;
}

/* Scroll bars. */
QScrollBar:vertical {
    background-color: transparent;
    width: 14px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.15);
    min-height: 40px;
    border-radius: 3px;
    margin: 4px 4px 4px 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.30);
    margin: 4px 3px 4px 3px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:pressed {
    background-color: rgba(0, 0, 0, 0.40);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 14px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.15);
    min-width: 40px;
    border-radius: 3px;
    margin: 6px 4px 4px 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 0.30);
    margin: 3px 4px 3px 4px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:pressed {
    background-color: rgba(0, 0, 0, 0.40);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

/* Tooltips. */
QToolTip {
    background-color: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
    padding: 6px 10px;
    color: #1A1A1A;
    font-size: 9pt;
}

/* Message box. */
QMessageBox {
    background-color: #F3F3F3;
}

QMessageBox QLabel {
    color: #1A1A1A;
    font-size: 10pt;
}

/* Table corner between headers. */
QTableCornerButton::section {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E5E5;
}
